extends Node
## Pooled SFX player + looping music (autoload "AudioManager").
## Sounds live in res://Sounds and are generated by Tools/generate_sounds.py.

const SFX := {
	"shoot_rifle": "res://Sounds/shoot_rifle.wav",
	"shoot_mg": "res://Sounds/shoot_mg.wav",
	"shoot_sniper": "res://Sounds/shoot_sniper.wav",
	"rocket_launch": "res://Sounds/rocket_launch.wav",
	"explosion": "res://Sounds/explosion.wav",
	"shoot_enemy": "res://Sounds/shoot_enemy.wav",
	"hit": "res://Sounds/hit.wav",
	"enemy_die": "res://Sounds/enemy_die.wav",
	"soldier_die": "res://Sounds/soldier_die.wav",
	"heal": "res://Sounds/heal.wav",
	"gate_good": "res://Sounds/gate_good.wav",
	"gate_bad": "res://Sounds/gate_bad.wav",
	"ui_click": "res://Sounds/ui_click.wav",
	"soldier_spawn": "res://Sounds/soldier_spawn.wav",
	"boss_roar": "res://Sounds/boss_roar.wav",
	"slam": "res://Sounds/slam.wav",
	"wave_horn": "res://Sounds/wave_horn.wav",
	"boss_shoot": "res://Sounds/boss_shoot.wav",
	"victory": "res://Sounds/victory.wav",
	"defeat": "res://Sounds/defeat.wav",
}
const MUSIC_PATH := "res://Sounds/music_battle.ogg"

## Minimum milliseconds between two plays of the same sound (anti-spam).
const GAP_MS := {
	"shoot_rifle": 55, "shoot_mg": 45, "shoot_sniper": 120, "rocket_launch": 120,
	"explosion": 70, "shoot_enemy": 80, "hit": 40, "enemy_die": 50, "soldier_die": 70,
	"heal": 200, "soldier_spawn": 60, "boss_shoot": 150,
}
## Per-sound base volume in dB.
const VOLUME_DB := {
	"shoot_rifle": -13.0, "shoot_mg": -16.0, "shoot_sniper": -8.0, "rocket_launch": -9.0,
	"explosion": -5.0, "shoot_enemy": -15.0, "hit": -17.0, "enemy_die": -12.0,
	"soldier_die": -10.0, "heal": -14.0, "gate_good": -6.0, "gate_bad": -6.0,
	"ui_click": -8.0, "soldier_spawn": -14.0, "boss_roar": -3.0, "slam": -3.0,
	"wave_horn": -8.0, "boss_shoot": -10.0, "victory": -4.0, "defeat": -4.0,
}
const POOL_SIZE := 16

var sfx_enabled: bool = true
var music_enabled: bool = true
var music_volume_db: float = -16.0

var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next: int = 0
var _last_ms: Dictionary = {}
var _music: AudioStreamPlayer = null


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for key in SFX:
		var stream = load(SFX[key])
		if stream != null:
			_streams[key] = stream
		else:
			push_warning("AudioManager: missing sound %s" % SFX[key])
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.volume_db = music_volume_db
	add_child(_music)


func play(sfx_name: String, pitch: float = 1.0) -> void:
	if not sfx_enabled or not _streams.has(sfx_name):
		return
	var now := Time.get_ticks_msec()
	var gap: int = GAP_MS.get(sfx_name, 0)
	if gap > 0 and now - int(_last_ms.get(sfx_name, -100000)) < gap:
		return
	_last_ms[sfx_name] = now
	var p := _players[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = _streams[sfx_name]
	p.volume_db = VOLUME_DB.get(sfx_name, -8.0)
	p.pitch_scale = pitch * randf_range(0.95, 1.05)
	p.play()


func play_music() -> void:
	if not music_enabled or _music == null or _music.playing:
		return
	var stream = load(MUSIC_PATH)
	if stream == null:
		return
	if stream is AudioStreamOggVorbis:
		stream.loop = true
	_music.stream = stream
	_music.volume_db = music_volume_db
	_music.play()


func stop_music() -> void:
	if _music != null:
		_music.stop()
